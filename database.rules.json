{
    "rules": {
      "userList": {
        ".read": "auth !== null",
        ".write": "auth !== null" 
      },
      "groups": {
        ".read": "auth !== null",
        ".write": "auth !== null" 
      },
     "users": {
       "$uid": {
         ".read": "auth !== null",
         ".write": "auth !== null"
       },
       "events": {
       	"$uid": {
           	".read": "$uid === auth.uid",
        		".write": "$uid === auth.uid"
         }
       },
      	"friends": {
          "$uid": {
          	".read": "auth !== null",
          	".write": "auth !== null" 
          }
        },
    },
    "anotherList": {
    	".read": true,
      ".write": true
    }
  }
}